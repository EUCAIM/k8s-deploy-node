system wn-gpu-small (
    # gpu.count = 1 and       that info is already specified in the instance_type
    # gpu.vendor = 'nvidia' and
    instance_type = '2024.imaging.XL.A30-2' and
    availability_zone = 'nova' and
    disk.0.os.name = 'linux' and
    # disk.0.image.url = 'ost://imaging.i3m.upv.es/027476d6-ec08-4159-be1d-44339bedf6c9' and   # ubuntu 24
    disk.0.image.url = 'ost://imaging.i3m.upv.es/5323263a-eba3-471d-994e-e653d1178309' and     # ubuntu 22
    disk.0.os.credentials.username = 'ubuntu'
)

