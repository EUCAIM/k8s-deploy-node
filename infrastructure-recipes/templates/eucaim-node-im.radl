description eucaim_node_im (
    kind = 'main' and
    short = 'Install IM for the project' and
    content = 'Version= 1.0 

Webpages: https://github.com/grycap/im'
)

# network public (
#     outports contains '8800/tcp' and
#     outports contains '8899/tcp'
# )
# Moved to the 'ubuntu' template

system front (
  ec3_templates contains 'im' and
  disk.0.applications contains (name = 'ansible.modules.grycap.im')
)

configure im_front (
@begin
  - roles:
    - role: 'grycap.im'
      im_container_runtine: 'containerd' 
      #im_etc_options:
      #  ACTIVATE_REST = True
      #  REST_PORT = 8800
      #  REST_ADDRESS = 0.0.0.0
      #  # REST_SSL: True
      #  # REST_SSL_KEYFILE = /etc/im/pki/server-key.pem
      #  # REST_SSL_CERTFILE =  /etc/im/pki/server-cert.pem
      #  # REST_SSL_CA_CERTS =  /etc/im/pki/ca-chain.pem
      #  ACTIVATE_XMLRPC = True
      #  XMLRCP_PORT = 8899
      #  XMLRCP_ADDRESS = 0.0.0.0
      #  # XMLRCP_SSL = True
      #  # XMLRCP_SSL_KEYFILE =  /etc/im/pki/server-key.pem
      #  # XMLRCP_SSL_CERTFILE = /etc/im/pki/server-cert.pem
      #  # XMLRCP_SSL_CA_CERTS = /etc/im/pki/ca-chain.pem
@end
)
