apiVersion: v1
kind: ConfigMap
metadata:
  name: viewer-front-angular-public-shared-config
data:
  front-config: |
    {
      "clientId": "{{ .Values.front.oidcClientId }}",
      "backendClientId": "{{ .Values.back.oidcClientId }}",
      "qpLinkClientId": "{{ .Values.qplink.oidcClientId }}",
      "authorityUrl": "{{ .Values.auth.oidcIssuerUrl }}/"
    }
